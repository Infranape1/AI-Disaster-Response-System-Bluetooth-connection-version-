<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="18dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nearby Emergency Hubs"
        android:textColor="@color/text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/scanStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:text="Scanning for active hubs..."
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <ListView
        android:id="@+id/hubList"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="14dp"
        android:divider="@null"
        android:dividerHeight="8dp"
        android:listSelector="@android:color/transparent"
        android:scrollbars="none" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRescan"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/btn_ghost"
            android:stateListAnimator="@null"
            android:text="RESCAN"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnManual"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_ghost"
            android:stateListAnimator="@null"
            android:text="ENTER ID"
            android:textColor="@color/text"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnCloseScan"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginLeft="8dp"
            android:layout_weight="1"
            android:background="@drawable/btn_ghost"
            android:stateListAnimator="@null"
            android:text="CLOSE"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
